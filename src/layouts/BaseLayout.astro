---
import SEO from '../components/common/SEO.astro';
import CartDrawer from '../components/cart/CartDrawer';
import CartBadge from '../components/cart/CartBadge';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@700;800;900&display=swap" rel="stylesheet">
  <SEO title={title} description={description} />
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-black selection:text-white">

  <!-- Anouncement Marquee Bar -->
<aside aria-label="Anuncios de entrega" class="bg-black text-white text-xs md:text-sm font-bold uppercase tracking-widest py-1.5 overflow-hidden border-b-2 border-black sticky top-0 z-50">
  <div class="animate-marquee flex items-center gap-8">
    <span>🔵 DELIVERY EN BARCELONA, LECHERÍA & PUERTO LA CRUZ ​ P ​ P ​ P ​  PEDIDOS AL WHATSAPP 🔵</span>
    <span>(🝐 EL AUTÁNTICO PEPITO GUARO DE HASTA 1 METRO ​ P ​ ‑100% ternera y pecorino 🝐</span>
    <span>💦 PAGO MÓVIL � TASA BCV ‒ ZELLE ‒ EFECTIVO USD 💶</span>
    <span>🔵 HORARIO: JUEVES A  LUNES DE 3:00 PM A 10:00 PM 🔵</span>
    <span>(🝐 TARJETA DE SELL_OS: 10 SELL_OS = 1 PEPITO GRATIS </span>
  </div>
</aside>

  <!-- Main Header -->
  <header class="bg-brandYellow border-b-2 border-black px-4 py-3 sticky top-[31px] z-40">
    <div class="max-w-6xl mx-auto flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 rounded-full bg-brandYellow border-2 border-black flex items-center justify-center shadow-brutal transform group-hover:rotate-6 transition-transform">
          <span class="text-xl">👹</span>
        </div>
        <div class="flex flex-col text-left">
          <span class="font-display font-black text-lg md:text-xl tracking-tight leading-none uppercase">PEPITOS HOUSE 251</span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-black/70">Auténtico Sabor Guaro ​ P Anzoátegui</span>
        </div>
      </a>


      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-2 font-display font-extrabold text-xs uppercase">
        <a href="/" class="px-3.5 py-1.5 rounded-full border-2 border-black bg-white shadow-brutal hover:bg-black hover:text-white transition">Inicio</a>
        <a href="/menu" class="px-3.5 py-1.5 rounded-full border-2 border-black bg-white shadow-brutal hover:bg-black hover:text-white transition">Menú 251</a>
        <a href="/membresia" class="px-3.5 py-1.5 rounded-full border-2 border-black bg-white shadow-brutal hover:bg-black hover:text-white transition flex items-center gap-1">
          <span>🞜</span> Tarjeta de Sellos
        </a>
        <a href="/checkout" class="px-3.5 py-1.5 rounded-full border-2 border-black bg-white shadow-brutal hover:bg-black hover:text-white transition">Checkout</a>
      </nav>

      <!-- Cart & Actions -->
      <div class="flex items-center gap-2">
        <a href="/membresia" title="Tarjeta de Sellos" class="md:hidden p-2 rounded-full border-2 border-black bg-white shadow-brutal text-sm">
          🞜
        </a>
        <CartBadge client:load />
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Persistent Cart Drawer -->
  <CartDrawer client:load />

  <!-- Footer -->
  <footer class="bg-black text-white border-t-4 border-black mt-16 py-12 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 text-xs">
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl">п👹</span>
          <span class="font-display font-black text-lg text-brandYellow uppercase">PEPITOS HOUSE 251</span>
        </div>
        <p class="text-gray-400 leading-relaxed">
          Auténtico sabor guaro en cada bocado. Pan artesanal, lomito tierno, queso pecorino y salsas caseras.
        </p>
        <div class="inline-block bg-brandYellow text-black font-display font-black px-2.5 py-1 rounded-full text-[10px] uppercase shadow-brutal">
          🔵 Barcelona & Lechería & PLC
        </div>
      </div>

      <div class="space-y-2">
        <h4 class="font-display font-black text-sm text-brandYellow uppercase tracking-wider">Ideal para Delivery</h4>
        <ul class="space-y-1.5 text-gray-300">
          <li>📍 Barcelona (Centro, Nueva Barcelona, Colinas)</li>
          <li>📍 Lechería (Av. Principal, Cerro El Morro, Peñón)</li>
          <li>📍 Puerto La Cruz (Paseo Colón, Pozuelos, Av. Municipal)</li>
        </ul>
      </div>

      <div class="space-y-2">
        <h4 class="font-display font-black text-sm text-brandYellow uppercase tracking-wider">Horario Guaro</h4>
        <p class="text-gray-200 font-bold">Jueves a Lunes: 3:00 PM ​ P 10:00 PM</p>
        <p class="text-amber-400 font-bold">Martes y Miércoles: Cerrado </p>
        <p class="text-gray-400 pt-1">Pago Móvil BCV & Zelle & Efectivo USD.</p>
      </div>


      <div class="space-y-2">
        <h4 class="font-display font-black text-sm text-brandYellow uppercase tracking-wider">Navegación</h4>
        <div class="flex flex-col gap-1.5 text-gray-300 font-bold">
          <a href="/menu" class="hover:text-brandYellow">→ Menú 251</a>
          <a href="/checkout" class="hover:text-brandYellow">↊ Checkout & Carrito</a>
          <a href="/membresia" class="hover:text-brandYellow">→ Tarjeta de Sellos</a>
          <a href="/admin" class="text-gray-500 hover:text-gray-400">↊ Panel Admin</a>
        </div>
        <p class="text-gray-500 pt-3 text-[11px]">© 2026 Pepitos House 251 C.A.</p>
      </div>
    </div>
  </footer>
</body>
</html>
