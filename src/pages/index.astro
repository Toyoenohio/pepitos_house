---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INITIAL_PRODUCTS, INITIAL_CATEGORIES } from '../lib/productsData';
import ProductCatalog from '../components/menu/ProductCatalog';
import { loadOverrides, applyOverrides } from '../lib/overrides';

// La disponibilidad (86 / días activos) la gestiona el panel y vive en Neon.
// Si la base no responde, loadOverrides devuelve {} y se usa el catálogo tal cual.
const products = applyOverrides(INITIAL_PRODUCTS, await loadOverrides(Astro.locals));
---

<BaseLayout 
  title="Pepitos House 251 | Auténtico Sabor Guaro en Barcelona, Lechería y PLC"
  description="Los mejores pepitos guaros con lomito, pecorino y salsas de la casa. Delivery en Barcelona, Lechería y Puerto La Cruz, Anzoátegui."
>
  <div class="max-w-6xl mx-auto w-full px-3 md:px-6 py-6 space-y-10">

    <!-- Hero Section -->
    <section class="bg-brandYellow rounded-3xl border-4 border-black p-6 sm:p-10 shadow-brutal-lg relative overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-5">
          <div class="inline-flex items-center gap-2 bg-white px-3.5 py-1 rounded-full border-2 border-black shadow-brutal">
            <span class="font-display font-black text-xs uppercase tracking-wider">
              Auténtico Sabor Guaro en Cada Bocado
            </span>
          </div>

          <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl uppercase tracking-tight leading-[0.95]">
            PEPITOS DE <br /><span class="text-brandBlue">HASTA 1 METRO</span>
          </h1>

          <p class="text-sm sm:text-base font-semibold text-black/85 leading-relaxed">
            Llena tu mesa con lomito angus, pan suave y recién tostado, lluvia de pecorino y las tradicionales salsas de la casa. Delivery directo a Barcelona, Lechería y Puerto La Cruz.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a 
              href="/menu" 
              class="bg-black hover:bg-brandBlue transition text-white font-display font-black px-6 py-3.5 rounded-full border-2 border-black shadow-brutal uppercase text-sm flex items-center gap-2"
            >
              <span>Ver Menú Completo</span>
              <span>→</span>
            </a>
            <a 
              href="/membresia" 
              class="bg-white hover:bg-brandYellow transition text-black font-display font-black px-6 py-3.5 rounded-full border-2 border-black shadow-brutal uppercase text-sm flex items-center gap-2"
            >
              <span>Tarjeta de Sellos</span>
            </a>
          </div>

          <!-- Badges -->
          <div class="pt-2 flex items-center gap-4 text-xs font-black uppercase text-black/70">
            <div class="flex items-center gap-1.5">
              <span class="text-green-600 font-bold">✓</span> 30cm, 50cm y 1 Metro
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-green-600 font-bold">✓</span> Pago Móvil BCV, Zelle
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-green-600 font-bold">✓</span> Delivery Anzoátegui
            </div>
          </div>
        </div>

        <!-- Hero Image Card -->
        <div class="flex items-center justify-center relative">
          <div class="w-full max-w-sm rounded-3xl border-4 border-black bg-white shadow-brutal-lg overflow-hidden transform hover:rotate-1 transition-transform">
            <div class="bg-brandBlue p-4 border-b-2 border-black flex items-center justify-between text-white">
              <span class="font-display font-black text-sm uppercase">Consiente al Chucho</span>
              <span class="bg-brandYellow text-black font-black text-[10px] px-2 py-0.5 rounded-full border border-black">100% lomito</span>
            </div>
            <div class="p-4">
              <img 
                src="/images/products/pepito-clasico.jpg" 
                alt="Pepito Tradicional 251"
                class="w-full h-64 object-cover rounded-2xl border-2 border-black"
              />
              <div class="mt-3 flex items-center justify-between">
                <div>
                  <h3 class="font-display font-black text-base uppercase">Pepito Clásico 251</h3>
                  <span class="text-xs font-bold text-gray-600">Lomito, Pollo o Mixto con tocineta y pecorino</span>
                </div>
                <span class="font-display font-black text-xl text-brandBlue">$13.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Features Section -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white p-5 sm:p-6 rounded-2xl border-3 border-black shadow-brutal space-y-2">
        <h3 class="font-display font-black text-base uppercase">Pago en Tu Moneda</h3>
        <p class="text-xs text-gray-600 font-semibold">
          Paga cómodamente con Pago Móvil (Tasa BCV), Zelle, Efectivo USD o Punto de Venta.
        </p>
      </div>

      <div class="bg-white p-5 sm:p-6 rounded-2xl border-3 border-black shadow-brutal space-y-2">
        <h3 class="font-display font-black text-base uppercase">Delivery Ruta Guara</h3>
        <p class="text-xs text-gray-600 font-semibold">
          Entrega rápida en Barcelona, Lechería y Puerto La Cruz. Tu pepito llega calientico.
        </p>
      </div>

      <div class="bg-white p-5 sm:p-6 rounded-2xl border-3 border-black shadow-brutal space-y-2">
        <h3 class="font-display font-black text-base uppercase">10 Sellos = 1 Gratis</h3>
        <p class="text-xs text-gray-600 font-semibold">
          Acumula sellos digitales con tu correo en cada pedido y reclama tu premio.
        </p>
      </div>
    </section>


    <!-- Menu Preview / 3 Featured Products -->
    <section id="menu-destacados" class="pt-2">
      <ProductCatalog 
        products={products} 
        categories={INITIAL_CATEGORIES} 
        featuredOnly={true}
        client:load 
      />
    </section>

    <!-- Google Maps & Location Section -->
    <section class="bg-white rounded-3xl border-4 border-black p-6 sm:p-8 shadow-brutal-lg space-y-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b-2 border-black pb-4">
        <div>
          <span class="inline-block bg-brandYellow text-black text-[11px] font-black px-3 py-0.5 rounded-full border-2 border-black mb-2 shadow-brutal uppercase tracking-wider">
            Visítanos en el Local
          </span>
          <h2 class="font-display font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight leading-none">
            ¿Dónde Estamos?
          </h2>
        </div>
        <p class="text-xs sm:text-sm font-semibold text-black/80 max-w-md">
          Ven a vivir la experiencia en vivo o coordina tu pedido con delivery a Barcelona, Lechería y Puerto La Cruz.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
        <!-- Info Cards Column -->
        <div class="space-y-4">
          <div class="bg-brandCream p-4 sm:p-5 rounded-2xl border-3 border-black shadow-brutal space-y-1.5">
            <span class="text-[10px] font-black uppercase text-brandBlue tracking-wider">Dirección</span>
            <h3 class="font-display font-black text-base uppercase">Pepitos House 251</h3>
            <p class="text-xs font-semibold text-gray-700 leading-relaxed">
              Barcelona, Estado Anzoátegui, Venezuela. Ubicación accesible para consumo en el local y retiro de pedidos.
            </p>
          </div>

          <div class="bg-brandCream p-4 sm:p-5 rounded-2xl border-3 border-black shadow-brutal space-y-1.5">
            <span class="text-[10px] font-black uppercase text-emerald-700 tracking-wider">Zona de Delivery</span>
            <h3 class="font-display font-black text-base uppercase">Gran Barcelona y Norte</h3>
            <p class="text-xs font-semibold text-gray-700 leading-relaxed">
              Despachamos directo a Barcelona, Lechería y Puerto La Cruz con empaques térmicos para que llegue caliente.
            </p>
          </div>

          <div class="bg-brandCream p-4 sm:p-5 rounded-2xl border-3 border-black shadow-brutal space-y-1.5">
            <span class="text-[10px] font-black uppercase text-purple-700 tracking-wider">Ruta GPS</span>
            <h3 class="font-display font-black text-base uppercase">Navega en tu Teléfono</h3>
            <p class="text-xs font-semibold text-gray-700 mb-2">
              Abre la ubicación directamente en Google Maps para trazar tu ruta en tiempo real.
            </p>
            <a 
              href="https://www.google.com/maps/place/Pepitos+House+251/@10.1477961,-64.6914144,17z" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 bg-black hover:bg-brandBlue text-white font-display font-black text-xs px-4 py-2 rounded-full border-2 border-black shadow-brutal uppercase transition-colors"
            >
              <span>Abrir en Google Maps</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Responsive Map Frame Column -->
        <div class="lg:col-span-2 rounded-2xl border-3 border-black shadow-brutal overflow-hidden bg-brandYellow relative">
          <!-- Brutalist Top Window Header -->
          <div class="bg-black text-white px-4 py-2.5 border-b-2 border-black flex items-center justify-between text-xs font-display font-black uppercase">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 border border-white"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-brandYellow border border-white"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500 border border-white"></span>
              <span class="ml-2 tracking-wider text-[11px]">Ubicación en Tiempo Real</span>
            </div>
            <span class="text-brandYellow text-[10px]">Google Maps</span>
          </div>

          <!-- Responsive iframe container -->
          <div class="w-full aspect-[4/3] sm:aspect-[16/10] md:h-[400px]">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3927.4037835199947!2d-64.6914144!3d10.147796099999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8c2d7366cf2ce667%3A0x7ace07d770acfe12!2sPepitos%20House%20251!5e0!3m2!1ses-419!2sve!4v1790712628494!5m2!1ses-419!2sve" 
              class="w-full h-full border-0 block" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="strict-origin-when-cross-origin"
              title="Ubicación de Pepitos House 251 en Google Maps"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
